# BFGA-PHM-Recommendation LLM configuration
#
# The CEG construction stage calls an OpenAI-compatible LLM API to map an input
# PHM case description onto the CEG schema. The original development used a third-party
# proxy (gemini-3.5-flash via api.viviai.cc). For public releases we *do not* ship the
# developer's credentials; you must supply your own.  You can use any
# OpenAI-compatible chat-completions endpoint — OpenAI, Azure, Together, OpenRouter,
# a self-hosted vLLM, etc. — by changing BFGA_LLM_API_URL.
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#     # edit .env
#
# Then `python -m dotenv run -- ...` (or `python-dotenv` auto-load) will inject the
# values into the process environment, where `code/.../m00_config.py` reads them.
#
# Alternatively you can export them in your shell before running:
#     export BFGA_LLM_API_KEY=...
#     export BFGA_LLM_API_URL=...
#     export BFGA_LLM_MODEL=gemini-3.5-flash

# === Required ===
# OpenAI-compatible chat-completions endpoint.
# Replace with your own endpoint (the URL below is a placeholder, not a credential).
BFGA_LLM_API_URL=https://api.example.com/v1/chat/completions

# Bearer token for that endpoint.
BFGA_LLM_API_KEY=REPLACE_ME

# Model identifier (any OpenAI-compatible name works as long as the upstream gateway
# supports it). The development run used gemini-3.5-flash.
BFGA_LLM_MODEL=gemini-3.5-flash

# === Optional ===
# Per-request timeout (seconds). Defaults to 300 in m00_config.py if unset.
BFGA_LLM_TIMEOUT=300
